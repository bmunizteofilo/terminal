{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug terminal_BMT.exe",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/terminal_BMT.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
            "preLaunchTask": "build terminal_BMT",
            "setupCommands": [
                {
                    "description": "Enable pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
