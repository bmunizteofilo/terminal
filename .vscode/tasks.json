{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build terminal_BMT",
            "type": "shell",
            "command": "C:/mingw64/bin/gcc.exe",
            "args": [
                "-g",
                "-I${workspaceFolder}/main/app",
                "-I${workspaceFolder}/main/can",
                "-I${workspaceFolder}/main/dbc",
                "-I${workspaceFolder}/main/ui",
                "${workspaceFolder}/main/app/main.c",
                "${workspaceFolder}/main/app/terminal.c",
                "${workspaceFolder}/main/can/can_slcan.c",
                "${workspaceFolder}/main/dbc/dbc_parser.c",
                "${workspaceFolder}/main/ui/vcu_dashboard.c",
                "${workspaceFolder}/main/ui/web_ui.c",
                "-lws2_32",
                "-lshell32",
                "-o",
                "${workspaceFolder}/terminal_BMT.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
